# Public client configuration only. Never place secrets here.
# Mock repositories stay active until API adapters are implemented.
# Optimized exports default to demo. Production is blocked until real adapters exist.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=

# Internal design review only; keep disabled in production.
EXPO_PUBLIC_DESIGN_SYSTEM=0

# Internal development only. Disabled in every optimized export, even with flag=1.
EXPO_PUBLIC_DEMO_AUTH=0
